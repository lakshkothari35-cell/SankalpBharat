{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores core information about every user, including their role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { 
          "type": "string", 
          "enum": ["donor", "volunteer", "staff", "manager", "admin"]
        },
        "mobileNumber": { "type": "string" },
        "photoURL": { "type": "string" },
        "language": { "type": "string", "enum": ["EN", "HI", "GU", "TA", "MR", "BN", "UR"] },
        "address": { "type": "string" },
        "state": { "type": "string" },
        "city": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Donation": {
      "title": "Donation Record",
      "description": "Records individual donations made by users.",
      "type": "object",
      "properties": {
        "donorId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string", "default": "INR" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "campaignId": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles keyed by UID."
    },
    "/donations/{donationId}": {
      "schema": "Donation",
      "description": "Collection of all donations."
    }
  }
}
