rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global hardened helpers
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Auth tokens NEVER contain custom claims. We look up roles in the users collection.
    function isAdmin() { 
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; 
    }
    
    // Validation Blueprints
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.name is string && data.name.size() <= 100 &&
             data.role in ['donor', 'volunteer', 'staff', 'manager', 'admin'] &&
             data.createdAt is string;
    }

    function isValidDonation(data) {
      return data.donorId is string && data.donorId.size() <= 128 &&
             data.amount is number && data.amount > 0 &&
             data.method is string && data.method.size() <= 50 &&
             data.timestamp is string && data.timestamp.size() <= 100;
    }

    // User Profile Rules
    match /users/{userId} {
      // Identity Integrity: Users can only read their own profile, Admins can read all.
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && isValidUser(incoming()) && 
        incoming().role == 'donor'; // New users must be donors
        
      allow update: if (isOwner(userId) && isValidUser(incoming()) && 
        incoming().role == existing().role && // Cannot change own role
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt
      ) || isAdmin();
      
      allow delete: if isAdmin();
    }

    // Donation Rules
    match /donations/{donationId} {
      // Secure List Queries: Users can only list their own donations.
      // Rules must evaluate resource.data to prevent unauthorized scraping.
      allow get: if isSignedIn() && (existing().donorId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.donorId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && 
        isValidDonation(incoming()) &&
        incoming().donorId == request.auth.uid;
        
      allow update, delete: if isAdmin();
    }
  }
}
